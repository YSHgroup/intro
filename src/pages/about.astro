---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkList from '../components/LinkList.astro';
import { owner, site, personalLinks } from '../data/site';
---

<BaseLayout title="About Me" description={`${owner.name}: ${owner.headline}`}>
  <section class="banner">
    <div class="container">
      <img
        class="banner-img"
        src="/images/david-banner.png"
        alt={`${owner.name}: Engineering ideas. Building businesses. Shaping the future.`}
        width="2216"
        height="710"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section profile">
    <div class="container">
      <div class="head">
        <img class="avatar" src="/images/david-avatar.jpg" alt={`Portrait of ${owner.name}`} width="160" height="160" />
        <div>
          <p class="eyebrow">About me</p>
          <h1>{owner.name}</h1>
          <p class="role">{owner.role} · {owner.location}</p>
          <p class="headline">{owner.headline}</p>
        </div>
      </div>

      <div class="body">
        {owner.bio.map((p) => <p>{p}</p>)}
        <p class="motto grad-text">{owner.motto}</p>
      </div>

      <h2>Why {site.name}?</h2>
      <p class="lead">{owner.whyThisProject}</p>

      <h2>Skills</h2>
      <div class="grid cols-4">
        {owner.skillGroups.map((g) => (
          <article class="card">
            <h3>{g.title}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>

      <h2>Find me online</h2>
      <LinkList items={personalLinks} />
    </div>
  </section>
</BaseLayout>

<style>
  .banner { background: var(--navy); }
  .banner-img { width: 100%; height: auto; display: block; }
  .banner .container { width: min(100%, 1600px); }
  .profile h2 { margin-top: 3rem; }
  .head { display: flex; gap: 1.75rem; align-items: center; margin-top: -4.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .avatar {
    width: 160px; height: 160px; border-radius: 50%; object-fit: cover; flex: none;
    border: 5px solid #fff; box-shadow: 0 6px 24px rgba(10, 26, 63, .25); background: #fff;
  }
  .head > div { padding-top: 3rem; }
  .head h1 { margin-bottom: .2rem; }
  .role { color: var(--navy-soft); font-weight: 600; margin: 0; }
  .headline { color: var(--muted); margin: .3rem 0 0; }
  .body { max-width: 72ch; font-size: 1.05rem; }
  .motto { font-size: 1.25rem; font-weight: 700; margin-top: 1.5rem; }
  @media (max-width: 640px) {
    .head { margin-top: -3.5rem; }
    .avatar { width: 120px; height: 120px; }
    .head > div { padding-top: 0; }
  }
</style>
