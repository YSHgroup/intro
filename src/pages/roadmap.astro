---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { phases, mvp, stack } from '../data/content';
import { site } from '../data/site';
import { breadcrumbLd } from '../data/seo';

const origin = Astro.site ?? new URL(site.url);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Roadmap', href: '/roadmap/' },
];
---

<BaseLayout
  title="Roadmap & MVP"
  description="Phased roadmap, MVP scope and planned architecture for Healthspan Network, an AI-powered healthspan and longevity research platform."
  jsonLd={[breadcrumbLd(crumbs, origin)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Roadmap</p>
      <h1>Build the network first, then the infrastructure.</h1>
      <p class="lead">
        The biggest risk is trying to build everything at once. The plan is to validate each layer
        before the next one. New here? Start with
        <a href="/#idea">the idea behind Healthspan Network</a> or read
        <a href="/about/">about the founder, David Chan</a>.
      </p>
      <div class="table-wrap" style="margin-top:2rem">
        <table>
          <thead>
            <tr><th>Phase</th><th>Name</th><th>Focus</th><th>Outcome</th></tr>
          </thead>
          <tbody>
            {phases.map((p) => (
              <tr>
                <td>{p.phase}</td>
                <td><strong>{p.name}</strong></td>
                <td>{p.focus}</td>
                <td>{p.outcome}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container grid cols-2">
      <article class="card">
        <h3>MVP scope</h3>
        <ul>{mvp.map((m) => <li>{m}</li>)}</ul>
      </article>
      <article class="card">
        <h3>Planned architecture</h3>
        <ul>{stack.map(([k, v]) => <li><strong>{k}:</strong> {v}</li>)}</ul>
      </article>
    </div>
  </section>

  <RelatedLinks current="/roadmap/" heading="Where to next?" />
</BaseLayout>
