---
interface Props {
  name: 'email' | 'website' | 'github' | 'huggingface' | 'reddit';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const stroked = name === 'email' || name === 'website';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  fill={stroked ? 'none' : 'currentColor'}
  stroke={stroked ? 'currentColor' : 'none'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'email' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 7 8.5 6.5L20.5 7" />
    </>
  )}
  {name === 'website' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c3 3.4 3 14.6 0 18M12 3c-3 3.4-3 14.6 0 18" />
    </>
  )}
  {name === 'github' && (
    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
  )}
  {name === 'huggingface' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <circle cx="8.6" cy="10" r="1.3" fill="#fff" />
      <circle cx="15.4" cy="10" r="1.3" fill="#fff" />
      <path d="M7.5 14c1 2.4 3 3.4 4.5 3.4s3.5-1 4.5-3.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
    </>
  )}
  {name === 'reddit' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <ellipse cx="12" cy="13.5" rx="5.5" ry="3.8" fill="#fff" />
      <circle cx="9.8" cy="13" r="1" />
      <circle cx="14.2" cy="13" r="1" />
      <circle cx="16.4" cy="10.3" r="1.1" fill="#fff" />
      <circle cx="7.6" cy="10.3" r="1.1" fill="#fff" />
      <path d="M12 9.7 12.9 6l2.6.6" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" />
    </>
  )}
</svg>
