---
import type { Crumb } from '../data/seo';

interface Props {
  /** Trail ending with the current page, e.g. [{ name: 'Home', href: '/' }, { name: 'Roadmap', href: '/roadmap/' }] */
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {items.map((c, i) => (
        <li>
          {i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs { background: var(--bg-soft); border-bottom: 1px solid var(--border); font-size: .9rem; }
  ol { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; margin: 0; padding: .6rem 0; }
  li:not(:last-child)::after { content: '›'; margin-left: .5rem; color: var(--muted); }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  [aria-current] { color: var(--muted); }
</style>
