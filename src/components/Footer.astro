---
import { owner, site, personalLinks, projectLinks } from '../data/site';
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <strong>{site.name}</strong>
      <p>{site.tagline}</p>
      <p class="proj">
        {projectLinks.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
            <Icon name={l.key} size={22} />
          </a>
        ))}
      </p>
    </div>
    <div>
      <p>A portfolio project by <a href="/about">{owner.name}</a></p>
      <p class="proj">
        {personalLinks.map((l) => (
          <a href={l.href} target={l.key === 'email' ? undefined : '_blank'} rel="noopener noreferrer" aria-label={l.label} title={l.label}>
            <Icon name={l.key} size={22} />
          </a>
        ))}
      </p>
    </div>
  </div>
  <div class="container fine">
    <small>
      © {new Date().getFullYear()} {owner.name}. Preview version. Not medical advice and not a medical service.
    </small>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: #cbd6ee; padding: 3rem 0 1.5rem; margin-top: 2rem; }
  .site-footer strong { color: #fff; }
  .site-footer a { color: #8fd8ff; }
  .inner { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .inner p { margin: .3rem 0 0; }
  .proj { display: flex; gap: .9rem; margin-top: .8rem !important; }
  .fine { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.15); opacity: .8; }
</style>
