---
import { owner, site } from '../data/site';
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <strong>{site.name}</strong>
      <p>{site.tagline}</p>
    </div>
    <div>
      <p>A portfolio project by <span class="placeholder">{owner.name}</span></p>
      <p>
        {owner.links.map((l, i) => (
          <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>
        ))}
      </p>
    </div>
  </div>
  <div class="container fine">
    <small>
      © {new Date().getFullYear()} {owner.name}. Concept stage. Not medical advice and not a medical service.
    </small>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: #cbd6ee; padding: 3rem 0 1.5rem; margin-top: 2rem; }
  .site-footer strong { color: #fff; }
  .site-footer a { color: #8fd8ff; }
  .inner { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .inner p { margin: .3rem 0 0; }
  .fine { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.15); opacity: .8; }
</style>
